PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=isnad_db
# Required, 32+ characters; the server refuses to start with this example value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_this_secret
JWT_EXPIRES=7d
# Optional: signs the ijaza QR codes (defaults to JWT_SECRET). Keep it stable, or issued QR codes stop verifying.
# QR_SECRET=
